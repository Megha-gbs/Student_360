# Student360 Environment Configuration
# Copy this file to .env and adjust variables as needed

# Application Environment
ENVIRONMENT=development
DEBUG=True

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Security & RBAC Secrets
JWT_SECRET_KEY=student360_development_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=480
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:5173

# Machine Learning Paths
MODEL_DIR=ml/models
DATA_DIR=data
DISABLE_MODEL_REGISTRY=true

# Institutional Portal Data Paths
DATA_PATH=backend/data/synthetic_students.json
INTERVENTIONS_PATH=backend/data/interventions.json
TIMELINE_PATH=backend/data/timeline_events.json

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000
